{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Auth": {
    "SessionLifetimeHours": 168,
    "IdleTimeoutMinutes": 720,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  },
  "SessionCookie": {
    "Secure": true
  },
  "RateLimits": {
    "AuthPerMinute": 10,
    "ApiPerMinute": 600,
    "AiPerMinute": 20,
    "WebhooksPerMinute": 600
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "TrustedNetworks": []
  },
  "Secrets": {
    "EncryptionKey": "",
    "KeyId": "k1"
  },
  "AiService": {
    "BaseUrl": "http://ai-service:8100",
    "ApiKey": "",
    "TimeoutSeconds": 90
  },
  "Integrations": {
    "PublicBaseUrl": ""
  },
  "Retention": {
    "LogRetentionDays": 30,
    "WebhookPayloadRetentionDays": 30,
    "ReadNotificationRetentionDays": 90,
    "ExpiredSessionRetentionDays": 30
  },
  "Workers": {
    "Enabled": true,
    "WebhookRetryIntervalSeconds": 15,
    "RetentionIntervalMinutes": 60
  }
}
