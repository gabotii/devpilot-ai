# Copy to .env and adjust. Never commit the real .env.
AI_ENVIRONMENT=development

# Shared secret the .NET backend sends in X-Internal-Api-Key (must match AiService:ApiKey).
# Required (32+ chars) when AI_ENVIRONMENT=production.
AI_INTERNAL_API_KEY=

# auto = Anthropic when ANTHROPIC_API_KEY is set, otherwise the deterministic heuristic provider.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
AI_FALLBACK_TO_HEURISTIC=true
AI_LOG_LEVEL=INFO
